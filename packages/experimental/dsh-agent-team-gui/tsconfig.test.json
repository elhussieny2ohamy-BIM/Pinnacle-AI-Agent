{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": ".",
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/index.ts",
    "src/spec.ts",
    "src/types.ts",
    "src/tools/**/*.ts",
    "tests/**/*.spec.ts",
    "vitest.host.config.ts"
  ],
  "exclude": [
    "tests/**/*.client.spec.ts",
    "tests/**/*.client.spec.tsx"
  ],
  "paths": {
    "@deepseek-ai/cordis": ["../../../vendor/cordis/src"],
    "@deepseek-ai/schemastery": ["../../../vendor/schemastery/src"],
    "@deepseek-ai/dsh-agent": ["../../../packages/core/agent/src"],
    "@deepseek-ai/dsh-llm": ["../../../packages/llm/llm/src"],
    "@deepseek-ai/dsh-jobs": ["../../../packages/jobs/jobs/src"],
    "@deepseek-ai/dsh-brand": ["../../../packages/util/brand/src"],
    "@deepseek-ai/dsh-session": ["../../../packages/core/session/src"],
    "@deepseek-ai/dsh-storage-domain": ["../../../packages/storage/storage-domain/src"],
    "@deepseek-ai/dsh-subagent": ["../../../packages/subagent/subagent/src"],
    "@deepseek-ai/dsh-tools": ["../../../packages/core/tools/src"],
    "@deepseek-ai/dsh-util-values": ["../../../packages/util/values/src"],
    "@deepseek-ai/dsh-client-connection": ["../../../packages/client/connection/src"],
    "@deepseek-ai/dsh-api-session-controller": ["../../../packages/api/session-controller/src/index.ts"]
  }
}
