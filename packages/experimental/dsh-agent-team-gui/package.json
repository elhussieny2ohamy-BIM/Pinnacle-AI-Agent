{
  "name": "@deepseek-ai/dsh-agent-team-gui",
  "version": "1.3.0",
  "description": "Persistent multi-model squads for DeepSeek Harness with durable orchestration, DAG workflows, run history, and provider-reported token usage",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/index.d.ts",
    "lib/types/client/index.d.ts",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "cordis.patch.yml",
    "assets/*.png",
    "examples/**/*.json",
    "docs/**/*.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "README-zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "agent",
    "multi-agent",
    "multi-model",
    "orchestration",
    "token-usage",
    "agent-team"
  ],
  "license": "MIT",
  "author": "leizihao and dsh-agent-team-gui contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toolclub/dsh-agent-team-gui.git",
    "directory": "packages/experimental/dsh-agent-team-gui"
  },
  "homepage": "https://github.com/toolclub/dsh-agent-team-gui#readme",
  "bugs": {
    "url": "https://github.com/toolclub/dsh-agent-team-gui/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "bundle": "tsdown --config tsdown.config.ts",
    "watch": "tsdown --watch --config tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.host.json --noEmit --pretty false && tsc -p tsconfig.client.json --noEmit --pretty false && tsc -p tsconfig.test.json --pretty false && tsc -p tsconfig.client-test.json --pretty false",
    "typecheck:host": "tsc -p tsconfig.host.json --noEmit --pretty false && tsc -p tsconfig.test.json --pretty false",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit --pretty false && tsc -p tsconfig.client-test.json --pretty false",
    "test": "pnpm run test:host && pnpm run test:client",
    "test:host": "vitest run --config vitest.host.config.ts",
    "test:client": "vitest run --config vitest.client.config.ts"
  },
  "dependencies": {
    "react": "^18.2.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-api-session-controller": "workspace:~",
    "@deepseek-ai/dsh-agent": "workspace:~",
    "@deepseek-ai/dsh-brand": "workspace:~",
    "@deepseek-ai/dsh-client-connection": "workspace:~",
    "@deepseek-ai/dsh-client-locale": "workspace:~",
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:~",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:~",
    "@deepseek-ai/dsh-client-ui-session": "workspace:~",
    "@deepseek-ai/dsh-client-ui-settings": "workspace:~",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:~",
    "@deepseek-ai/dsh-jobs": "workspace:~",
    "@deepseek-ai/dsh-llm": "workspace:~",
    "@deepseek-ai/dsh-session": "workspace:~",
    "@deepseek-ai/dsh-storage": "workspace:~",
    "@deepseek-ai/dsh-storage-domain": "workspace:~",
    "@deepseek-ai/dsh-subagent": "workspace:~",
    "@deepseek-ai/dsh-system-prompt": "workspace:~",
    "@deepseek-ai/dsh-tools": "workspace:~",
    "@deepseek-ai/dsh-util-values": "workspace:~",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-jobs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-attachment": "workspace:*",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/dsh-client-connection": "workspace:*",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "@deepseek-ai/dsh-client-store": "workspace:*",
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-session": "workspace:*",
    "@deepseek-ai/dsh-client-ui-settings": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@deepseek-ai/dsh-compaction": "workspace:*",
    "@deepseek-ai/dsh-commands": "workspace:*",
    "@deepseek-ai/dsh-jobs": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-scope": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-session-projection": "workspace:*",
    "@deepseek-ai/dsh-storage": "workspace:*",
    "@deepseek-ai/dsh-storage-domain": "workspace:*",
    "@deepseek-ai/dsh-subagent": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-util-values": "workspace:*",
    "@deepseek-ai/dsh-user-approval": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "happy-dom": "^20.11.2",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.14",
    "vitest": "^4.1.10"
  }
}
