# ============================================================
# Pinnacle AI Agent - workspace root repository
# Tracks ONLY our custom code (PINNACLE-MCP-HUB + pack-aec + docs).
# Everything heavy / external / third-party is ignored.
# ============================================================

# --- Nested git repositories & huge external trees (not tracked here) ---
/deepseek-harness/
/rvt-mcp-master/
/Autocad-MCP-main/
/Civil3D-mcp-main/
/NavisWorksMaster-main/
/rhino-mcp-main/
/Sketchup MCP/
/Archive/

# --- Root source archives (large, not needed in git) ---
/*.zip

# --- Dependencies & build artifacts ---
node_modules/
**/node_modules/
dist/
lib/**/*.map
*.tgz
out/
build/
obj/
bin/
venv/
**/.venv/
__pycache__/
*.pyc
.cache/
.desktop-build/
artifacts/
/release-assets/

# --- Local release builds ---
/installer/output/
/PINNACLE-MCP-HUB/dist/
/PINNACLE-MCP-HUB/sandbox/client-build/lib/
*.bak_pinnacle_*

# --- Local settings, logs, OS junk ---
.DS_Store
Thumbs.db
desktop.ini
*.log
.env
.env.*
*.user
.vs/
.idea/

# --- Keep our own built hub lib (small, part of the package) ---
!PINNACLE-MCP-HUB/lib/

# --- Local MCP scratch probes (kept on disk, not tracked) ---
/test_*.py
/find_packages.py

# --- Local deck/screenshot artifacts ---
/_annot_balance.png
/footer_crop_view.png
/pinnacle-ai-agent-deck.html
