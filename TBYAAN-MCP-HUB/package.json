{
  "name": "@PINNACLE/mcp-hub",
  "version": "0.1.3",
  "private": true,
  "description": "Generic MCP hub for DeepSeek Harness with an AEC pack: discovery, supervision, write policy, backup, and a single control tool, plus a web client page (Modules and Doctor screens).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/en.json": "./locale/en.json",
    "./locale/ar.json": "./locale/ar.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json"
  },
  "icon": "icon.png",
  "files": [
    "lib/**/*.js",
    "lib/**/*.map",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "README.md",
    "servers.lock",
    "INTEGRATION.md",
    "AGENTS.md",
    "UPGRADE_PROMPT.md",
    "docs/PHASE*-STATUS.md",
    "docs/PHASE0-AUDIT.md",
    "scripts/**/*.ps1"
  ],
  "engines": {
    "dsh": ">=0.2.2-alpha.3 <0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ],
      "inject": [
        "slots",
        "locale",
        "layout",
        "remote"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "pack": "npm pack --pack-destination dist"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.2.2-alpha.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3"
  },
  "license": "UNLICENSED"
}

